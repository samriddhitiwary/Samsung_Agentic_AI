# Copy to .env and adjust for your machine.
# Do not put reproducible benchmark settings here.

# Local llama.cpp server binary, used by humans/helper scripts when starting the server.
JCR_LLAMA_CPP_EXECUTABLE=C:\path\to\llama-server.exe

# Local llama.cpp embedding server address.
JCR_LLAMA_SERVER_HOST=127.0.0.1
JCR_LLAMA_SERVER_PORT=8081

# Local embedding cache directory. Relative paths are resolved from the project root.
JCR_GGUF_CACHE_DIR=data/cache/jina_code_0.5b_gguf
